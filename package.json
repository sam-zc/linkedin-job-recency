{
  "name": "linkedin-job-recency",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run typecheck && vite build && vite build --config vite.content.config.ts && node scripts/verify-build.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run typecheck && npm test",
    "test": "node --test tests/*.test.ts",
    "preview": "vite preview --host 127.0.0.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.6",
    "@types/node": "^26.6.5",
    "happy-dom": "^21.0.4",
    "prettier": "3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
